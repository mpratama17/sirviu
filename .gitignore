# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google Cloud OAuth client secret JSON — real credentials, never commit.
client_secret*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local dev artifacts
supabase/.branches
supabase/.temp

# Editor
.vscode/*
!.vscode/extensions.json

# Playwright CLI session artifacts (screenshots/snapshots/logs from ad-hoc
# browser verification, not test fixtures)
.playwright-cli/

# claude.ai/design exports — personal design-reference material, not
# application source. Large (HTML bundle + zip) and not needed to build/run
# the app; the actual UI decisions from these are already implemented.
SIRVIU.html
/SIRVIU Aplikasi UI Lengkap/
/SIRVIU Aplikasi UI Lengkap.zip
Design.pdf

# AI-agent working docs / specs — kept locally for development, not pushed
# to GitHub (user's explicit choice).
AGENTS.md
CLAUDE.md
CLAUDE_CODE_BRIEF.md
DESIGN_BRIEF.md
.claude/
